# Keep the .jks OUTSIDE the repo (e.g. ~/keys/). Copy this file to keystore.properties (same folder) and fill in. keystore.properties and the .jks file are
# gitignored: never commit them, and back both up somewhere safe.
storeFile=/absolute/path/to/keys/bartaguard-upload.jks
storePassword=
keyAlias=upload
keyPassword=
